      - name: Wait for Uploads with Progress Monitoring
        if: steps.verify.outputs.verify_success == 'true'
        run: |
          cd downloads
          
          echo "========================================="
          echo "⏳ MONITORING UPLOAD PROGRESS"
          echo "========================================="
          
          # Function to get upload progress
          get_upload_progress() {
            if [ -f "series_upload_complete.txt" ]; then
              echo "100|complete"
              return
            fi
            
            if [ -f "series_upload.log" ]; then
              # Count total files
              local total_files=$(ls -1 *.mp4 2>/dev/null | wc -l)
              # Count completed files
              local completed=$(grep -c "COMPLETE_" series_upload.log 2>/dev/null || echo "0")
              # Count currently uploading
              local current=$(grep "STARTING_" series_upload.log 2>/dev/null | tail -1 | grep -oE "[^_]+\.mp4" | head -1)
              
              if [ "$total_files" -gt 0 ]; then
                local percent=$((completed * 100 / total_files))
                echo "$percent|${completed}/${total_files}|${current}"
              else
                echo "0|0/0|"
              fi
            else
              echo "0|0/0|"
            fi
          }
          
          # Main monitoring loop
          START_TIME=$(date +%s)
          UPLOAD_COMPLETE=false
          
          echo ""
          echo "🔄 Monitoring upload progress..."
          echo "   (Updates every 5 seconds)"
          echo ""
          
          while true; do
            # Check completion
            if [ -f "series_upload_complete.txt" ]; then
              UPLOAD_COMPLETE=true
            fi
            
            # If complete, break out of loop
            if [ "$UPLOAD_COMPLETE" = true ]; then
              echo ""
              echo "✅ ALL UPLOADS COMPLETED!"
              echo ""
              break
            fi
            
            CURRENT_TIME=$(date +%s)
            ELAPSED=$((CURRENT_TIME - START_TIME))
            
            # Format elapsed time
            if [ $ELAPSED -lt 60 ]; then
              ELAPSED_STR="${ELAPSED}s"
            elif [ $ELAPSED -lt 3600 ]; then
              ELAPSED_STR="$((ELAPSED / 60))m $((ELAPSED % 60))s"
            else
              ELAPSED_STR="$((ELAPSED / 3600))h $(((ELAPSED % 3600) / 60))m"
            fi
            
            clear 2>/dev/null || printf "\033c" 2>/dev/null || echo ""
            
            echo "╔══════════════════════════════════════════════════════════════╗"
            echo "║           📤 SERIES UPLOAD PROGRESS MONITOR                 ║"
            echo "╠══════════════════════════════════════════════════════════════╣"
            echo "║ ⏱️  Elapsed Time: $(printf "%-40s" "$ELAPSED_STR")║"
            echo "║                                                              ║"
            
            # Get progress
            PROGRESS_DATA=$(get_upload_progress)
            PERCENT=$(echo "$PROGRESS_DATA" | cut -d'|' -f1)
            COUNT=$(echo "$PROGRESS_DATA" | cut -d'|' -f2)
            CURRENT_FILE=$(echo "$PROGRESS_DATA" | cut -d'|' -f3)
            
            TOTAL_FILES=$(ls -1 *.mp4 2>/dev/null | wc -l)
            
            echo "║ 📹 Series Uploads:                                        ║"
            echo "║    Progress: $(printf "%-51s" "${PERCENT}% (${COUNT} of ${TOTAL_FILES})")║"
            
            # Create progress bar
            BAR_LENGTH=40
            FILLED=$((PERCENT * BAR_LENGTH / 100))
            BAR=""
            for ((i=0; i<$FILLED && i<$BAR_LENGTH; i++)); do BAR="${BAR}█"; done
            for ((i=$FILLED; i<$BAR_LENGTH; i++)); do BAR="${BAR}░"; done
            echo "║    [${BAR}] ║"
            
            if [ -n "$CURRENT_FILE" ] && [ "$CURRENT_FILE" != "null" ]; then
              echo "║    Current: $(printf "%-49s" "${CURRENT_FILE}")║"
            fi
            
            # Calculate ETA if we have progress
            if [[ "$COUNT" == *"/"* ]]; then
              COMPLETED=$(echo "$COUNT" | cut -d'/' -f1)
              if [ "$COMPLETED" -gt 0 ] && [ "$ELAPSED" -gt 10 ]; then
                AVG_TIME=$((ELAPSED / COMPLETED))
                REMAINING=$((TOTAL_FILES - COMPLETED))
                ETA_SECONDS=$((AVG_TIME * REMAINING))
                if [ $ETA_SECONDS -lt 60 ]; then
                  ETA_STR="${ETA_SECONDS}s"
                elif [ $ETA_SECONDS -lt 3600 ]; then
                  ETA_STR="$((ETA_SECONDS / 60))m $((ETA_SECONDS % 60))s"
                else
                  ETA_STR="$((ETA_SECONDS / 3600))h $(((ETA_SECONDS % 3600) / 60))m"
                fi
                echo "║    ETA: $(printf "%-51s" "$ETA_STR")║"
              fi
            fi
            
            echo "║                                                              ║"
            echo "╚══════════════════════════════════════════════════════════════╝"
            
            # Check for errors
            if [ -f "series_upload.log" ]; then
              if tail -5 series_upload.log 2>/dev/null | grep -q "❌"; then
                echo ""
                echo "⚠️  Warning: Possible errors detected in upload log"
                echo "   Check series_upload.log for details"
              fi
            fi
            
            sleep 5
          done
          
          echo "========================================="
          echo "✅ ALL UPLOADS COMPLETED SUCCESSFULLY!"
          echo "========================================="
          
          # Show final logs
          if [ -f "series_upload.log" ]; then
            echo ""
            echo "📋 Final upload log:"
            echo "========================================="
            tail -20 series_upload.log
            echo "========================================="
          fi
          
          echo ""
          echo "📊 Upload Summary:"
          echo "========================================="
          echo "⏱️  Total Time: $ELAPSED_STR"
          echo "📊 Total Series: $(ls -1 *.mp4 2>/dev/null | wc -l)"
          echo "========================================="
          if [ -f "series_upload_complete.txt" ]; then
            echo "🎉 All series uploaded successfully!"
          fi
          echo "========================================="

